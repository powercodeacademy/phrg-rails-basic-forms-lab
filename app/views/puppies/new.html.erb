<h1>Create Puppy Listing</h1>
<%= form_with model: @puppy, local: true do |form| %>
  <%= form.label :name, "Puppy's name: " %>
  <%= form.text_field :name %><br>

  <%= form.label :breed, "Puppy's breed: " %>
  <%= form.text_field :breed %><br>

  <%= form.label :age, "Puppy's age: " %>
  <%= form.number_field :age, in: 0..30 %><br>

  <%= form.submit "Create listing" %>
<% end %>