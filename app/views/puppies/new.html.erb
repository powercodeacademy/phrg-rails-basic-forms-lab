<h1> List A Puppy </h1>

<%= form_with model: @puppy, local: true do |form| %>
  <%= form.label :name, "Name" %>
  <%= form.text_field :name %>

  <%= form.label :breed, "Breed" %>
  <%= form.text_field :breed %>

  <%= form.label :age, "Age" %>
  <%= form.text_field :age %>

  <%= form.submit "Create Puppy" %>
<% end %>  

