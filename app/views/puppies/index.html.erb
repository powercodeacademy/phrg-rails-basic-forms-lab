<h1>Available Puppies</h1>
<% if @puppies.count.zero? %>
  <h4>No puppies available yet. Be the first to add one!</h4>
<% else %>
  <% @puppies.each do |puppy| %>
    <h4><%= "#{puppy.name} - #{puppy.breed} (#{puppy.age})" %></h4>
    <%= link_to "View Details", puppy_path(puppy) %>
  <% end %>
<% end %>
<hr>
<%= link_to "Click Here To List A Puppy", new_puppy_path %>